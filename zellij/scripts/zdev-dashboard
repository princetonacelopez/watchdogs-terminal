#!/usr/bin/env python3
"""
zdev-dashboard: Clean, minimal futuristic weather telemetry widget.
Displays clean simple-text location, temperature, conditions, and daily scripture/jokes.
No big ASCII clock digits and no side weather art/satellite icon.
"""

import sys
import os
import re
import time
import json
import random
import signal
import shutil
import textwrap
import unicodedata
import urllib.request
import threading
from datetime import datetime

# Watch Dogs ctOS 2.0 / DedSec TrueColor ANSI Palette (#00F0FF / #FF0055)
C_RESET   = "\033[0m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_ITALIC  = "\033[3m"

C_CYAN    = "\033[38;2;0;240;255m"    # Signature ctOS Electric Cyan (#00F0FF)
C_RED     = "\033[38;2;255;0;85m"     # DedSec Intrusion Crimson (#FF0055)
C_WHITE   = "\033[38;2;226;241;255m"  # Crisp ctOS Ice White (#E2F1FF)
C_SILVER  = "\033[38;2;195;218;238m"  # Secondary HUD Readout (#C3DAEE)
C_GRAY    = "\033[38;2;122;147;172m"  # Tactical Slate Labels (#7A93AC)
C_DARK    = "\033[38;2;30;46;66m"     # Dark Grid Divider (#1E2E42)
C_AMBER   = "\033[38;2;255;214;0m"    # ctOS Profiler Amber (#FFD600)
C_GREEN   = "\033[38;2;0;255;156m"    # Access Granted Mint (#00FF9C)

WEATHER_CACHE_FILE = "/tmp/zdev_weather_clark.json"
BIBLE_CACHE_FILE   = "/tmp/zdev_bible_daily.json"
WEATHER_REFRESH_INTERVAL = 1200  # 20 minutes
QUOTE_REFRESH_INTERVAL   = 45    # 45 seconds

