weather_lock = threading.Lock()
telemetry_data = {
    "location": "Clark, Pampanga",
    "lat": "15.18°N",
    "lon": "120.55°E",
    "alt": "148m",
    "temp": "20",
    "desc": "Sunny",
    "humidity": "70",
    "wind_spd": "4 km/h",
    "wind_dir": "NE",
    "solar_output": "89%",
    "battery": "94%"
}

current_verse   = BIBLE_VERSES[0]
current_quote   = random.choice(DEV_QUOTES)
last_quote_time = 0
running         = True

def load_cached_data():
    global telemetry_data, current_verse
    if os.path.exists(WEATHER_CACHE_FILE):
        try:
            with open(WEATHER_CACHE_FILE, "r") as f:
                d = json.load(f)
                if isinstance(d, dict) and "temp" in d:
                    telemetry_data.update(d)
        except Exception:
            pass

    today_str = datetime.now().strftime("%Y-%m-%d")
    if os.path.exists(BIBLE_CACHE_FILE):
        try:
            with open(BIBLE_CACHE_FILE, "r") as f:
                bdata = json.load(f)
                if bdata.get("date") == today_str and "text" in bdata and "ref" in bdata:
                    current_verse = (bdata["text"], bdata["ref"])
        except Exception:
            pass

load_cached_data()

def cleanup(sig=None, frame=None):
    global running
    running = False
    sys.stdout.write("\033[?25h\033[0m\n")
    sys.stdout.flush()
    sys.exit(0)

signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)

def str_width(s):
    clean = re.sub(r'\033\[[0-9;]*[a-zA-Z]', '', s)
    width = 0
    for ch in clean:
        w = unicodedata.east_asian_width(ch)
        if w in ('W', 'F') or ord(ch) >= 0x1F300:
            width += 2
        else:
            width += 1
    return width

def make_meter(val_pct, total_blocks=10):
    try:
        pct = int(str(val_pct).replace("%", "").strip())
    except Exception:
        pct = 75
    pct = max(0, min(100, pct))
    filled = int(round((pct / 100.0) * total_blocks))
    empty = total_blocks - filled
    return f"{C_GREEN}{'█' * filled}{C_DARK}{'░' * empty}{C_RESET} {C_SILVER}{pct}%{C_RESET}"

def fetch_weather_worker():
    global telemetry_data
    while running:
        now = time.time()
        cached = False
        if os.path.exists(WEATHER_CACHE_FILE):
            try:
                with open(WEATHER_CACHE_FILE, "r") as f:
                    data = json.load(f)
                    if now - data.get("timestamp", 0) < WEATHER_REFRESH_INTERVAL:
                        with weather_lock:
                            telemetry_data.update(data)
                        cached = True
            except Exception:
                pass

        if not cached:
            try:
                req = urllib.request.Request(
                    "https://wttr.in/Clark,Pampanga?format=j1",
                    headers={"User-Agent": "curl/7.88.1"}
                )
                with urllib.request.urlopen(req, timeout=4) as resp:
                    raw = json.loads(resp.read().decode("utf-8"))
                    curr = raw["current_condition"][0]
                    desc = curr["weatherDesc"][0]["value"].strip()
                    temp_c = curr["temp_C"]
                    humidity = curr["humidity"]
                    wind = f"{curr['windspeedKmph']} km/h"
                    wind_dir = curr.get("winddir16Point", "NE")

                    with weather_lock:
                        telemetry_data.update({
                            "temp": temp_c,
                            "desc": desc,
                            "humidity": humidity,
                            "wind_spd": wind,
                            "wind_dir": wind_dir,
                            "timestamp": now
                        })

                    with open(WEATHER_CACHE_FILE, "w") as f:
                        json.dump(telemetry_data, f)
            except Exception:
                pass

        for _ in range(WEATHER_REFRESH_INTERVAL):
            if not running:
                break
            time.sleep(1)

def fetch_daily_bible_worker():
    global current_verse
    while running:
        today_str = datetime.now().strftime("%Y-%m-%d")
        needs_fetch = True
        if os.path.exists(BIBLE_CACHE_FILE):
            try:
                with open(BIBLE_CACHE_FILE, "r") as f:
                    bdata = json.load(f)
                    if bdata.get("date") == today_str and "text" in bdata:
                        current_verse = (bdata["text"], bdata["ref"])
                        needs_fetch = False
            except Exception:
                pass

        if needs_fetch:
            try:
                req = urllib.request.Request(
                    "https://beta.ourmanna.com/api/v1/get?format=json&order=daily",
                    headers={"User-Agent": "curl/7.88.1"}
                )
                with urllib.request.urlopen(req, timeout=4) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                    details = data["verse"]["details"]
                    text = details["text"].strip()
                    ref  = details["reference"].strip()
                    current_verse = (text, ref)
                    with open(BIBLE_CACHE_FILE, "w") as f:
                        json.dump({"date": today_str, "text": text, "ref": ref}, f)
            except Exception:
                day_idx = datetime.now().timetuple().tm_yday % len(BIBLE_VERSES)
                current_verse = BIBLE_VERSES[day_idx]

        for _ in range(3600):
            if not running:
                break
            time.sleep(1)

def render():
    global current_quote, last_quote_time
    now = datetime.now()
    now_ts = time.time()

    if now_ts - last_quote_time > QUOTE_REFRESH_INTERVAL:
        current_quote = random.choice(DEV_QUOTES)
        last_quote_time = now_ts

    cols, rows = shutil.get_terminal_size((40, 20))
    cols = max(24, cols)
    inner_width = max(10, cols - 4)

    buf = []
    buf.append("\033[H\033[?25l")

    with weather_lock:
        t = dict(telemetry_data)

    date_str = now.strftime("%A, %b %d")
    temp_str = str(t.get("temp", "20"))
    desc_str = t.get("desc", "Sunny").upper()
    humidity = t.get("humidity", "70")
    wind_spd = t.get("wind_spd", "4 km/h")
    wind_dir = t.get("wind_dir", "NE")

    # 1. Watch Dogs ctOS Telemetry Header
    hdr = f" {C_CYAN}{C_BOLD}⌁ [ctOS // ENV_PROFILER]{C_RESET} {C_WHITE}CLARK, PAMPANGA{C_RESET}  {C_RED}//{C_RESET} {C_GRAY}{t['lat']}, {t['lon']}{C_RESET}"
    buf.append(f"{hdr}\033[K")

    # 2. Clean Simple-Text Weather Data (with live clock readout)
    t_line = f" {C_GRAY}SYNC:{C_RESET} {C_CYAN}{C_BOLD}{now.strftime('%H:%M:%S')}{C_RESET} {C_SILVER}({date_str}){C_RESET}  {C_RED}│{C_RESET}  {C_CYAN}{C_BOLD}{temp_str}°C{C_RESET} {C_WHITE}{desc_str}{C_RESET}"
    buf.append(f"{t_line}\033[K")

    t_sub = f" {C_GRAY}HUMIDITY:{C_RESET} {C_SILVER}{humidity}%{C_RESET}  {C_GRAY}│{C_RESET}  {C_GRAY}WIND:{C_RESET} {C_SILVER}{wind_spd} {wind_dir}{C_RESET}  {C_GRAY}│{C_RESET}  {C_GRAY}ELEV:{C_RESET} {C_SILVER}{t['alt']}{C_RESET}"
    buf.append(f"{t_sub}\033[K")

    # Telemetry progress bars
    meter_sol = make_meter(t.get("solar_output", "89%"), total_blocks=8)
    meter_bat = make_meter(t.get("battery", "94%"), total_blocks=8)
    buf.append(f" {C_GRAY}UPLINK:{C_RESET} {meter_sol}  {C_GRAY}│{C_RESET}  {C_GRAY}CORE_PWR:{C_RESET} {meter_bat}\033[K")

    # Hairline divider
    buf.append(f" {C_DARK}{'┄' * (cols - 2)}{C_RESET}\033[K")

    # Section 1: Daily Scripture
    v_header = f" {C_RED}{C_BOLD}⌁{C_RESET} {C_CYAN}{C_BOLD}[DEDSEC // DAILY_SCRIPTURE]{C_RESET}"
    buf.append(f"{v_header}\033[K")

    v_text, v_ref = current_verse
    wrapped_verse = textwrap.wrap(f'"{v_text}"', width=inner_width)
    for line in wrapped_verse:
        buf.append(f" {C_SILVER}{C_ITALIC}{line}{C_RESET}\033[K")
    buf.append(f" {C_AMBER}— {v_ref}{C_RESET}\033[K")

    # Hairline divider
    buf.append(f" {C_DARK}{'┄' * (cols - 2)}{C_RESET}\033[K")

    # Section 2: Dev Quips & Jokes
    q_header = f" {C_RED}{C_BOLD}⌁{C_RESET} {C_CYAN}{C_BOLD}[ctOS // DEV_INTERCEPT_LOG]{C_RESET}"
    buf.append(f"{q_header}\033[K")

    q1, q2 = current_quote
    w_q1 = textwrap.wrap(q1, width=inner_width)
    w_q2 = textwrap.wrap(q2, width=inner_width)

    for line in w_q1:
        buf.append(f" {C_SILVER}{line}{C_RESET}\033[K")
    for line in w_q2:
        buf.append(f" {C_AMBER}{C_ITALIC}{line}{C_RESET}\033[K")

    sys.stdout.write("\n".join(buf[:rows]) + "\033[J")
    sys.stdout.flush()

def main():
    if "--once" in sys.argv:
        render()
        cleanup()

    t_weather = threading.Thread(target=fetch_weather_worker, daemon=True)
    t_weather.start()

    t_bible = threading.Thread(target=fetch_daily_bible_worker, daemon=True)
    t_bible.start()

    render()

    while running:
        time.sleep(1)
        render()

if __name__ == "__main__":
    main()
